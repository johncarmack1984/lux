# Local provider plugins (the committed .terraform.lock.hcl is kept)
.terraform/
# Variable files hold secrets (e.g. discord_public_key)
*.tfvars
*.auto.tfvars
# Remote state is in S3; ignore any local state that shows up
*.tfstate
*.tfstate.*
# Saved plans (ephemeral)
tfplan
*.tfplan
# Placeholder Lambda zips built by the archive provider on every plan — one per
# function (accounts.tf, nudge.tf, apple-auth.tf, plan-bridge.tf). Build output,
# not source: cargo-lambda ships the real code.
.*-placeholder.zip
# Discord registration secrets (bot token + application id)
discord.env
